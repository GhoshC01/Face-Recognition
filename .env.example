# --- Application ---
APP_NAME=Face Verification API
APP_VERSION=1.0.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=true

# --- Security ---
# Enable this and set a real secret in every non-local environment.
API_KEY_ENABLED=false
API_KEY=changeme
# Empty = no CORS headers at all (this is a server-to-server API). Only set
# this if a browser-based client genuinely needs to call the API directly.
CORS_ALLOW_ORIGINS=[]
# TLS should normally be terminated by a reverse proxy/ingress in front of
# this service; only set this if the app itself must enforce/redirect to https.
ENFORCE_HTTPS=false
REQUEST_TIMEOUT_SECONDS=30.0
# In-memory, per-process rate limiting -- a reasonable single-instance
# default, but not a substitute for gateway-level limiting when scaled out.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60.0

# --- Models ---
DETECTOR_MODEL_PATH=models/det_500m.onnx
RECOGNIZER_MODEL_PATH=models/w600k_mbf.onnx
ONNX_INTRA_OP_THREADS=0
ONNX_INTER_OP_THREADS=0

# --- Detection ---
DETECTOR_INPUT_SIZE=640
DETECTOR_CONFIDENCE_THRESHOLD=0.5
DETECTOR_NMS_THRESHOLD=0.4
MAX_FACES_TO_CONSIDER=5
STRICT_SINGLE_FACE_ON_ENROLL=true

# --- Recognition ---
RECOGNIZER_INPUT_SIZE=112
EMBEDDING_DIMENSION=512
VERIFICATION_SIMILARITY_THRESHOLD=0.36
IDENTIFICATION_SIMILARITY_THRESHOLD=0.40
IDENTIFICATION_TOP_K=5

# --- Enrollment ---
ENROLLMENT_DUPLICATE_POLICY=reject
# Raw enrollment photos saved under <dir>/<external_id>/<embedding_id>.jpg. Set
# to empty to disable and keep only derived embeddings (see SECURITY.md).
ENROLLMENT_IMAGES_DIR=images

# --- Multi-frame verification ---
MULTI_FRAME_MIN_FRAMES=3
MULTI_FRAME_MAX_FRAMES=5
MULTI_FRAME_MIN_VALID_FRAMES=2
MULTI_FRAME_MIN_AGREEING_FRAMES=2
MULTI_FRAME_CONSENSUS_RATIO=0.6

# --- Quality gates ---
QUALITY_MIN_DETECTION_CONFIDENCE=0.5
QUALITY_MIN_FACE_WIDTH_PX=60
QUALITY_MIN_FACE_HEIGHT_PX=60
QUALITY_MIN_FACE_AREA_RATIO=0.02
QUALITY_MIN_BRIGHTNESS=40.0
QUALITY_MAX_BRIGHTNESS=230.0
QUALITY_MIN_SHARPNESS=60.0

# --- Storage ---
FAISS_INDEX_DIR=storage/faiss
METADATA_DIR=storage/metadata
FAISS_INDEX_FILENAME=index.faiss
METADATA_FILENAME=metadata.json

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=8
REMOTE_IMAGE_TIMEOUT_SECONDS=10.0
REMOTE_IMAGE_MAX_REDIRECTS=5
